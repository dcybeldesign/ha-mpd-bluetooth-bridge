# ============================================================
# mpd.conf.template — Modèle de configuration MPD
# ============================================================
# Fichier presque normal de config MPD, SAUF les valeurs ${BLUETOOTH_SINK}
# et ${SPEAKER_NAME} plus bas : ce texte est remplacé par run.sh au
# démarrage (via envsubst) par les vraies valeurs calculées/saisies dans
# les options de l'add-on. On ne peut pas les écrire en dur ici puisque
# l'adresse MAC (et le nom de l'enceinte) sont configurables par
# l'utilisateur — chaque installation a sa propre enceinte.

playlist_directory  "/var/lib/mpd/playlists"
# Pas de "music_directory" ni de "db_file" : Music Assistant envoie
# directement des URL de flux HTTP à MPD (streaming), il n'y a donc
# aucune bibliothèque musicale locale à scanner/indexer. Les avoir
# déclarés causait un plantage au démarrage ("Failed to open
# '/var/lib/mpd/database': No such file or directory") — en réalité
# une fonctionnalité dont on n'a pas besoin du tout ici.
# Pas de "log_file" ici : en l'absence de cette directive et puisqu'on
# lance MPD avec "--no-daemon" (voir run.sh), MPD écrit ses logs sur
# stderr — ce qui les fait apparaître directement dans le "Journal" de
# l'add-on visible depuis Home Assistant. Un essai précédent avec
# log_file "syslog" ne remontait nulle part de visible (pas de démon
# syslog qui relaie vers la sortie du conteneur).

# --- Réseau ---
bind_to_address     "0.0.0.0"
port                "6600"
# Doit correspondre exactement au port déclaré dans config.yaml,
# sinon Music Assistant ne pourra pas se connecter.

# --- Pas de mot de passe ---
# L'add-on n'est accessible que depuis le réseau local (pas exposé sur
# Internet par défaut), donc pas d'authentification MPD pour rester
# simple. À reconsidérer si jamais l'instance devient accessible depuis
# l'extérieur (voir section Sécurité du README).

# --- Sortie audio : c'est la partie qui nous intéresse ---
audio_output {
    type            "pulse"
    name            "${SPEAKER_NAME}"
    # Nom affiché côté MPD pour cette sortie (purement cosmétique),
    # remplacé au démarrage par le nom saisi dans les options de l'add-on.

    server          "unix:/run/audio/pulse.sock"
    # Sans cette ligne, MPD échouait avec "Failed to open audio output"
    # alors que la commande "pactl" (outil séparé) trouvait le serveur
    # sans problème via ce même socket — le plugin pulse intégré à MPD
    # ne fait pas la même auto-détection que la CLI pactl, il faut le
    # lui indiquer explicitement.

    sink            "${BLUETOOTH_SINK}"
    # <-- Remplacé au démarrage par run.sh (via envsubst), ex :
    #     bluez_sink.AA_BB_CC_DD_EE_FF.a2dp_sink
    # C'est ce qui force MPD à jouer précisément sur cette enceinte, et
    # non sur la sortie audio "par défaut" de l'hôte (jack/HDMI).
    # ATTENTION à la syntaxe : envsubst ne reconnaît QUE `$VAR`/`${VAR}`,
    # pas `{{VAR}}` façon Jinja/Mustache — utiliser cette dernière ici
    # ferait échouer silencieusement toute lecture audio (MPD tenterait
    # de se connecter à un sink qui n'existe pas).
}

# --- Format audio ---
audio_output_format "44100:16:2"
# Format standard des sinks Bluetooth A2DP (s16le 2ch 44100Hz), pour
# éviter que MPD ne fasse un rééchantillonnage inutile. Vérifiable pour
# ton enceinte avec `pactl list short sinks` en SSH sur l'hôte.

restore_paused      "yes"
# Si le service redémarre, MPD se remet en pause plutôt que de repartir
# en lecture toute seule.
